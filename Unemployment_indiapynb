        "%%writefile app.py\n",
        "import streamlit as st\n",
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "\n",
        "# Configure page style\n",
        "st.set_page_config(page_title=\"Unemployment Analysis App\", layout=\"wide\")\n",
        "\n",
        "# Header\n",
        "st.title(\"📈 Unemployment Analysis Dashboard (India)\")\n",
        "st.markdown(\"Explore the unemployment rate trends, employment figures, and labour participation across various regions and areas in India.\")\n",
        "\n",
        "# Load dataset and cache it\n",
        "@st.cache_data\n",
        "def load_data():\n",
        "    df = pd.read_csv('/content/Unemployment in India.csv')\n",
        "    df.columns = df.columns.str.strip()\n",
        "    df_clean = df.dropna(how='all').copy()\n",
        "    for col in ['Region', 'Frequency', 'Area']:\n",
        "        if col in df_clean.columns:\n",
        "            df_clean[col] = df_clean[col].astype(str).str.strip()\n",
        "    df_clean['Date'] = pd.to_datetime(df_clean['Date'].str.strip(), format='%d-%m-%Y', errors='coerce')\n",
        "    df_clean['Year'] = df_clean['Date'].dt.year\n",
        "    df_clean['Month_Name'] = df_clean['Date'].dt.strftime('%B')\n",
        "    return df_clean.dropna()\n",
        "\n",
        "data = load_data()\n",
        "\n",
        "# Sidebar Filters\n",
        "st.sidebar.header(\"Filter Options\")\n",
        "all_regions = sorted(data['Region'].unique())\n",
        "selected_region = st.sidebar.multiselect(\"Select Region / State\", options=all_regions, default=all_regions[:5])\n",
        "selected_area = st.sidebar.multiselect(\"Select Area Type\", options=data['Area'].unique(), default=list(data['Area'].unique()))\n",
        "\n",
        "# Apply filters\n",
        "filtered_data = data[(data['Region'].isin(selected_region)) & (data['Area'].isin(selected_area))]\n",
        "\n",
        "# Key Metrics columns\n",
        "col1, col2, col3 = st.columns(3)\n",
        "with col1:\n",
        "    avg_unemployment = filtered_data['Estimated Unemployment Rate (%)'].mean()\n",
        "    st.metric(label=\"Avg Unemployment Rate\", value=f\"{avg_unemployment:.2f}%\" if not pd.isna(avg_unemployment) else \"N/A\")\n",
        "with col2:\n",
        "    avg_employed = filtered_data['Estimated Employed'].mean()\n",
        "    st.metric(label=\"Avg Employed Count\", value=f\"{avg_employed:,.0f}\" if not pd.isna(avg_employed) else \"N/A\")\n",
        "with col3:\n",
        "    avg_participation = filtered_data['Estimated Labour Participation Rate (%)'].mean()\n",
        "    st.metric(label=\"Avg Labour Participation\", value=f\"{avg_participation:.2f}%\" if not pd.isna(avg_participation) else \"N/A\")\n",
        "\n",
        "# Visualization 1: Line Chart over Time\n",
        "st.subheader(\"Unemployment Trends Over Time\")\n",
        "if not filtered_data.empty:\n",
        "    fig_line = px.line(\n",
        "        filtered_data,\n",
        "        x='Date',\n",
        "        y='Estimated Unemployment Rate (%)',\n",
        "        color='Region',\n",
        "        line_dash='Area',\n",
        "        title=\"Unemployment Rate Timeline\"\n",
        "    )\n",
        "    st.plotly_chart(fig_line, use_container_width=True)\n",
        "else:\n",
        "    st.warning(\"No data available for the selected filters.\")\n",
        "\n",
        "# Visualization 2: Regional bar comparison\n",
        "st.subheader(\"Unemployment Comparison by Region\")\n",
        "if not filtered_data.empty:\n",
        "    fig_bar = px.bar(\n",
        "        filtered_data.groupby('Region')['Estimated Unemployment Rate (%)'].mean().reset_index().sort_values(by='Estimated Unemployment Rate (%)', ascending=False),\n",
        "        x='Estimated Unemployment Rate (%)',\n",
        "        y='Region',\n",
        "        color='Estimated Unemployment Rate (%)',\n",
        "        orientation='h',\n",
        "        title=\"Average Unemployment Rate by State/Region\"\n",
        "    )\n",
        "    st.plotly_chart(fig_bar, use_container_width=True)\n",
        "\n",
        "# Display Raw Data Table\n",
        "if st.checkbox(\"Show Raw Filtered Data\"):\n",
        "    st.subheader(\"Raw Data\")\n",
        "    st.dataframe(filtered_data)"
      ],
      "execution_count": null,
      "outputs": []
