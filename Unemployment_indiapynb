      },
      "source": [
        "# Drop completely empty rows and clean spaces from categorical values\n",
        "df_clean = df.dropna(how='all').copy()\n",
        "for col in ['Region', 'Frequency', 'Area']:\n",
        "    if col in df_clean.columns:\n",
        "        df_clean[col] = df_clean[col].astype(str).str.strip()\n",
        "\n",
        "# Standardize the Date column\n",
        "df_clean['Date'] = pd.to_datetime(df_clean['Date'].str.strip(), format='%d-%m-%Y', errors='coerce')\n",
        "\n",
        "# Add helper columns for Year and Month\n",
        "df_clean['Year'] = df_clean['Date'].dt.year\n",
        "df_clean['Month_Name'] = df_clean['Date'].dt.strftime('%B')\n",
        "\n",
        "# Drop remaining NaN values if any rows are still incomplete\n",
        "df_clean = df_clean.dropna()\n",
        "\n",
        "print(\"Cleaned Dataset Information:\")\n",
        "df_clean.info()\n",
        "print(\"\\nSummary Statistics for Numeric Columns:\")\n",
        "display(df_clean.describe())"
