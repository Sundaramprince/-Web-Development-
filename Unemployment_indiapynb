        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Set figure style\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "fig, axes = plt.subplots(3, 1, figsize=(14, 18))\n",
        "\n",
        "# 1. Timeline Trend of Unemployment Rate\n",
        "sns.lineplot(data=df_clean, x='Date', y='Estimated Unemployment Rate (%)', hue='Area', ax=axes[0], errorbar=None, marker='o')\n",
        "axes[0].set_title('Unemployment Rate Trend over Time (Rural vs Urban)', fontsize=14, fontweight='bold')\n",
        "axes[0].set_xlabel('Date')\n",
        "axes[0].set_ylabel('Estimated Unemployment Rate (%)')\n",
        "\n",
        "# 2. Regional Analysis (Average Unemployment by State)\n",
        "region_order = df_clean.groupby('Region')['Estimated Unemployment Rate (%)'].mean().sort_values(ascending=False).index\n",
        "sns.barplot(data=df_clean, x='Estimated Unemployment Rate (%)', y='Region', ax=axes[1], order=region_order, hue='Region', palette='viridis', legend=False, errorbar=None)\n",
        "axes[1].set_title('Average Unemployment Rate by Region / State', fontsize=14, fontweight='bold')\n",
        "axes[1].set_xlabel('Average Estimated Unemployment Rate (%)')\n",
        "axes[1].set_ylabel('Region')\n",
        "\n",
        "# 3. Distribution Comparison (Urban vs Rural Boxplot)\n",
        "sns.boxplot(data=df_clean, x='Area', y='Estimated Unemployment Rate (%)', ax=axes[2], hue='Area', palette='Set2', legend=False)\n",
        "axes[2].set_title('Distribution of Unemployment Rate: Urban vs Rural', fontsize=14, fontweight='bold')\n",
        "axes[2].set_xlabel('Area')\n",
        "axes[2].set_ylabel('Estimated Unemployment Rate (%)')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
